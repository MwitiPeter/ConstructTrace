# --- Core ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database (local MongoDB Community or free MongoDB Atlas) ---
MONGODB_URI=mongodb://127.0.0.1:27017/constructtrace
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/constructtrace?retryWrites=true&w=majority

# --- Auth ---
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Uploads ---
MAX_UPLOAD_MB=15
# Render Persistent Disk mount path (leave unset for local development)
UPLOADS_DIR=
# Supabase Storage (when configured, PDFs are stored in this private bucket)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=papers

# --- AI ---
# rule = 100% local, no external calls (default, always available)
# hf   = free Hugging Face Inference API (requires HF_TOKEN); falls back to rule automatically on any failure
AI_PROVIDER=rule
HF_TOKEN=
HF_MODEL=google/gemma-2-2b-it
HF_API_URL=https://router.huggingface.co/v1/chat/completions
HF_EMBEDDING_URL=https://api-inference.huggingface.co/models/sentence-transformers/all-MiniLM-L6-v2
